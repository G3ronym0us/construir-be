{{!--
  Cabecera común. Uso:
    {{> header eyebrow=orderNumberLabel }}
  El logo va oscuro sobre blanco: no hay imagen sobre color, así que la
  cabecera sobrevive intacta si el cliente bloquea imágenes.
--}}
<tr>
  <td style="background-color:#ffffff;border-bottom:3px solid #e2851b;padding:18px 26px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="left" style="vertical-align:middle">
          <img src="{{logoUrl}}" alt="Constru-ir" width="120" style="display:block;height:24px;width:auto;border:0;outline:none;text-decoration:none" />
        </td>
        {{#if eyebrow}}
        <td align="right" style="vertical-align:middle;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#8b8781">{{eyebrow}}</td>
        {{/if}}
      </tr>
    </table>
  </td>
</tr>
