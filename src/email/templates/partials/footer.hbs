{{!--
  Pie común. Uso:
    {{> footer }}                     pie completo con datos de tienda
    {{> footer compact=true }}        una sola línea
  Los datos de tienda llegan del payload (store*), no van escritos acá.
--}}
<tr>
  <td style="background-color:#f2efe9;border-top:1px solid #e7e3dd;padding:{{#if compact}}18px 26px{{else}}20px 26px{{/if}}">
    {{#unless compact}}
    <p style="margin:0 0 7px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#14181d">Constru-ir · Materiales de construcción</p>
    {{/unless}}
    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:#7d7a74">
      {{#unless compact}}{{storeAddress}} · {{storeHours}}<br />{{/unless}}
      WhatsApp {{storePhone}} · {{storeEmail}}{{#if storeRif}} · RIF {{storeRif}}{{/if}}
    </p>
    {{#if orderNumber}}
    <p style="margin:7px 0 0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;line-height:1.6;color:#9a968f">Te escribimos por tu pedido {{orderNumber}} en construir.com. Este buzón no se atiende: para hablar con alguien usa el WhatsApp.</p>
    {{/if}}
  </td>
</tr>
