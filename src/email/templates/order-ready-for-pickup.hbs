<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="es">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light only" />
<meta name="supported-color-schemes" content="light only" />
<title>{{subject}}</title>
<!--[if mso]><style>body,table,td{font-family:Arial,Helvetica,sans-serif !important}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#eceae5;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%">
<div style="display:none;font-size:1px;color:#f2efe9;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden">{{preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eceae5">
  <tr>
    <td align="center" style="padding:24px 12px">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background-color:#ffffff;border:1px solid #ded9d2;border-radius:14px;overflow:hidden">
{{> header eyebrow=(concat "Pedido " orderNumber) }}
        <tr>
          <td style="background-color:#e8f2ea;border-bottom:1px solid #c9e0d1;padding:12px 26px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12.5px;font-weight:700;letter-spacing:.4px;color:#1f7a4d">LISTO PARA RETIRAR{{#if readySince}} · desde {{readySince}}{{/if}}</td>
        </tr>
        <tr>
          <td style="background-color:#f7f5f2;padding:26px 26px 0">
            <h1 style="margin:0 0 8px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:23px;line-height:1.2;font-weight:700;color:#0f4c81">Ya puedes venir por él, {{customerName}}</h1>
            <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#55524d">Los {{items.length}} renglones de tu pedido ({{totalUnits}} unidades) están empacados y separados a tu nombre en el mostrador de despacho.</p>
          </td>
        </tr>

        <tr>
          <td style="background-color:#f7f5f2;padding:18px 26px 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid #e7e3dd;border-radius:10px">
              <tr><td style="padding:18px">
                <p style="margin:0 0 12px;padding-bottom:10px;border-bottom:1px solid #e7e3dd;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#14181d">Para retirarlo necesitas</p>
                <p style="margin:0 0 10px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#55524d"><strong style="color:#14181d">Cédula {{customerIdentification}}</strong> — la misma del pedido; si viene otra persona, avísanos antes por WhatsApp</p>
                <p style="margin:0 0 10px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#55524d"><strong style="color:#14181d">Número de pedido {{orderNumber}}</strong> — dilo en el mostrador</p>
                <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#55524d"><strong style="color:#14181d">Vehículo con capacidad</strong> — {{#if bulkyNote}}{{bulkyNote}}{{else}}revisa el volumen del material antes de venir{{/if}}</p>
              </td></tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="background-color:#f7f5f2;padding:18px 26px 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid #e7e3dd;border-radius:10px">
              <tr><td style="padding:18px">
                <p style="margin:0 0 9px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;color:#8b8781">Dónde y cuándo</p>
                <p style="margin:0 0 6px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#14181d">{{store.name}}</p>
                <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.6;color:#55524d">{{store.address}}{{#if store.city}}, {{store.city}}{{/if}}<br />{{store.hours}}</p>
              </td></tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="background-color:#f7f5f2;padding:18px 26px 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr><td align="center" bgcolor="#e2851b" style="border-radius:10px">
                <a href="{{trackingUrl}}" style="display:block;padding:15px 20px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#14181d;text-decoration:none;border-radius:10px">Ver mi pedido</a>
              </td></tr>
            </table>
{{#if whatsappUrl}}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px">
              <tr><td align="center" bgcolor="#ffffff" style="border:1.5px solid #d9d4cc;border-radius:10px">
                <a href="{{whatsappUrl}}" style="display:block;padding:13px 20px;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#0f4c81;text-decoration:none;border-radius:10px">Avisar que voy · WhatsApp</a>
              </td></tr>
            </table>
{{/if}}
          </td>
        </tr>
        <tr><td style="background-color:#f7f5f2;line-height:26px;font-size:26px;height:26px">&nbsp;</td></tr>
{{> footer compact=true }}
      </table>
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px">
        <tr><td style="padding:14px 8px 0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;line-height:1.6;color:#9a968f">Constru-ir · Materiales de construcción · Caracas, Venezuela</td></tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
